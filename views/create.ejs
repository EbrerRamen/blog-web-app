<% const pageTitle = 'Create post'; const activeNav = 'create'; %>
<%- include("partials/header.ejs") %>

<section class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Posts</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
            <div class="card border-0 shadow-sm form-card">
                <div class="card-body p-4 p-md-5">
                    <p class="page-eyebrow mb-2">New entry</p>
                    <h1 class="page-title h2 mb-1">Create post</h1>
                    <p class="text-muted mb-4">Add a title and your content below.</p>
                    <form action="/create" method="POST" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="title" class="form-label fw-semibold">Title</label>
                            <input type="text" class="form-control form-control-lg" id="title" name="title"
                                placeholder="e.g. Getting started with Express" required maxlength="120">
                            <div class="invalid-feedback">Please enter a title.</div>
                        </div>
                        <div class="mb-4">
                            <label for="content" class="form-label fw-semibold">Content</label>
                            <textarea class="form-control" id="content" name="content" rows="10"
                                placeholder="Write your post here..." required></textarea>
                            <div class="invalid-feedback">Please add some content.</div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-2" aria-hidden="true"></i>Create post
                            </button>
                            <a href="/" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include("partials/footer.ejs") %>
