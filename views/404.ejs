<% const pageTitle = 'Not found'; const activeNav = ''; %>
<%- include("partials/header.ejs") %>

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="empty-state card border-0 shadow-sm py-5 px-4">
                <div class="empty-state-icon mx-auto mb-3" aria-hidden="true">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <h1 class="h3 mb-2">Page not found</h1>
                <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'That page does not exist.' %></p>
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door me-2" aria-hidden="true"></i>Back to posts
                </a>
            </div>
        </div>
    </div>
</section>

<%- include("partials/footer.ejs") %>
